{
  "name": "@timenote/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.21.1 <23 || >=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/start.ts",
    "env:init": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts",
    "lint:fix": "eslint apps packages scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backup": "tsx scripts/backup.ts",
    "icons": "tsx scripts/generateIcons.ts",
    "media:guide": "tsx scripts/captureGuideMedia.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@fuego0/configs": "1.2.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "antd": "6.6.4",
    "drizzle-orm": "0.45.2",
    "eslint": "10.10.0",
    "ical.js": "2.2.1",
    "jsdom": "26.1.0",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "tsx": "4.23.13"
  }
}
