# 复制为 .env 后按需修改；.env 已被 Git 忽略。本文件只含占位值，不要填入真实密码。
# 本机开发可直接运行 `pnpm env:init` 生成带随机管理员密码的 .env。

# development | test | production。production 强制 HTTPS 来源与安全 Cookie。
NODE_ENV=development

# 浏览器访问的同源地址，也是订阅链接的基址；只含协议、主机和端口，生产必须是 https://。
# 手机在局域网调试订阅时改为电脑的局域网地址，例如 http://192.168.1.10:8720。
WEB_ORIGIN=http://127.0.0.1:8720

# Web 监听地址与端口；API 固定只监听 127.0.0.1，由 Web 同源反代。
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8720
API_PORT=8721

# SQLite 数据文件；必须是文件路径。Docker 中固定为 /data/timenote.sqlite。
SQLITE_PATH=./data/timenote.sqlite
# pnpm db:backup 的目标文件，必须是尚不存在的路径。
SQLITE_BACKUP_PATH=./backups/timenote-YYYYMMDD.sqlite

# 请求日志目录（按 web/api 分目录、按天分文件），默认 .tmp/logs。
LOG_DIR=

# 新账号默认时区（IANA 名称）。
DEFAULT_TIME_ZONE=Asia/Shanghai

# 首个管理员：仅在数据库没有任何账号时创建一次，之后修改这里不会改动已有账号。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-to-a-long-random-password

# 可选：留空使用默认值。
# COOKIE_SECURE 仅开发环境可设为 true/false；生产强制 true。
COOKIE_SECURE=
# 会话有效期（秒），默认 30 天。
SESSION_TTL_SECONDS=
# 每分钟每个来源地址的登录尝试次数，默认 10。
LOGIN_RATE_LIMIT=
# 请求体上限（字节），默认 1 MiB，影响备份导入大小。
REQUEST_BODY_LIMIT=
# 订阅窗口：过去几年（默认 1）与未来几年（默认 20）。
FEED_WINDOW_PAST_YEARS=
FEED_WINDOW_FUTURE_YEARS=
