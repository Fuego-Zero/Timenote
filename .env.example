# 复制为 .env 后按需修改；.env 已被 Git 忽略。本文件只有占位值，不要填入真实密码。
# 本机开发也可直接运行 `pnpm env:init` 生成基础 .env；首个管理员在空库时通过 Web 首次引导创建。

# development | test | production；production 强制 HTTPS 同源与安全 Cookie。
NODE_ENV=development

# 浏览器访问的同源地址，也是订阅链接的基址。只含协议、主机和端口，生产环境用 https://。
# 手机在局域网调试订阅时改为本机的局域网地址，例如 http://192.168.1.10:8720。
WEB_ORIGIN=http://127.0.0.1:8720

# Web 监听地址与端口；API 固定只绑 127.0.0.1，由 Web 同源反代。
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8720
API_PORT=8721

# SQLite 数据文件，必须是文件路径。Docker 中固定为 /data/timenote.sqlite。
SQLITE_PATH=./data/timenote.sqlite
# pnpm db:backup 的目标文件；目录不存在时会创建。
SQLITE_BACKUP_PATH=./backups/timenote-YYYYMMDD.sqlite

# 运行日志目录，含 web/api 子目录与滚动文件；默认 .tmp/logs。
LOG_DIR=

# 新账号默认时区（IANA 名称）。
DEFAULT_TIME_ZONE=Asia/Shanghai

# 请求完整性 MAC 主密钥：base64url，解码后至少 32 字节。production 必填。
# development/test 可留空（使用固定开发派生密钥）。生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SIGN_MASTER_KEY=

# 仅 development：未设为 0 时绕过真实会话，注入首个启用 admin 到 req.user（无鉴权、不写 Cookie）。设为 0 关闭。production/test 无效。
DEV_AUTH_BYPASS=

# 可选；未设时使用默认值。
# COOKIE_SECURE 非生产可显式设为 true/false；生产强制 true。
COOKIE_SECURE=
# 会话有效期（秒），默认 30 天。
SESSION_TTL_SECONDS=
# 每分钟每来源地址的登录尝试次数，默认 10。
LOGIN_RATE_LIMIT=
# 每分钟每来源地址的公开注册次数，默认 5（建议 ≤ LOGIN_RATE_LIMIT）。
REGISTER_RATE_LIMIT=
# 是否开放公开自助注册：true / false，默认 false。开启后新注册账号默认停用。
PUBLIC_REGISTER_ENABLED=
# 请求体上限（字节），默认 1 MiB；影响备份导入大小。
REQUEST_BODY_LIMIT=
# 订阅窗口：过去年数（默认 1）与未来年数（默认 20）。
FEED_WINDOW_PAST_YEARS=
FEED_WINDOW_FUTURE_YEARS=
